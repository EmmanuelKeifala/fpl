{
  "name": "fpl-agent",
  "version": "1.0.0",
  "description": "AI-powered Fantasy Premier League assistant with game theory optimization",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:auto": "node dist/scheduler/runner.js",
    "start:render": "npm run preflight:shadow && npm run start:auto",
    "auto": "tsx src/scheduler/runner.ts",
    "auto:once": "tsx src/scheduler/runner.ts --once",
    "health": "tsx src/scheduler/health-check.ts",
    "preflight": "tsx src/scheduler/preflight.ts",
    "preflight:shadow": "tsx src/scheduler/preflight.ts --require-shadow",
    "preflight:live": "tsx src/scheduler/preflight.ts --require-live",
    "mutations:resolve": "tsx src/scheduler/resolve-operation.ts",
    "backtest:prepare": "tsx src/backtest/index.ts prepare-data",
    "backtest:run": "tsx src/backtest/index.ts run-season",
    "backtest:full": "tsx src/backtest/index.ts run-season --strategy=deployment",
    "backtest:ml": "tsx src/backtest/index.ts run-season --strategy=deployment-ml --season=2025-2026",
    "ml:calibrate-policy": "tsx src/ml/calibrate-policy.ts",
    "ml:live-features": "python3 scripts/ml/live_features.py",
    "llm:smoke": "tsx src/llm/smoke.ts",
    "kapso:smoke": "tsx src/notifications/kapso-smoke.ts",
    "backtest:experiment": "tsx src/backtest/index.ts run-experiment",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "keywords": [
    "fpl",
    "fantasy-premier-league",
    "ai-agent",
    "openai"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@openai/agents": "^0.4.4",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "sql.js": "^1.14.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/sql.js": "^1.4.9",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
