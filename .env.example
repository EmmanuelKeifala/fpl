# FPL Agent Environment Variables

# OpenAI API Key (required)
OPENAI_API_KEY=your_openai_api_key

# FPL OAuth login (required for any team action: transfers, lineup, chips)
FPL_EMAIL=your_fpl_email
FPL_PASSWORD=your_fpl_password
# Tokens are refreshed and stored in data/fpl-session.json. As an alternative,
# provide the Fantasy site's OAuth access token directly.
FPL_COOKIE=
FPL_BEARER_TOKEN=

# Your FPL Manager ID (found in your team URL)
FPL_MANAGER_ID=your_manager_id

# Optional: extra free transfer grants announced in-season, e.g. "16:5" for an
# AFCON top-up to 5 free transfers before GW16. Empty when none are scheduled.
FPL_TRANSFER_TOP_UPS=

# Deployment mode is shadow unless explicitly changed to live. Live mode also
# requires FPL_EXPECTED_MANAGER_ID to match the authenticated account.
FPL_RUN_MODE=shadow
FPL_EXPECTED_MANAGER_ID=
# A running worker also checks this file before every mutation.
FPL_EMERGENCY_STOP_FILE=data/EMERGENCY_STOP
FPL_RUNNER_LOCK_PATH=data/fpl-runner.lock
FPL_MUTATION_LOCK_PATH=data/fpl-mutation.lock
FPL_DB_LOCK_PATH=data/fpl.db.lock
FPL_HEALTH_PATH=data/runner-health.json

# Autonomous Mode Configuration (all mutations default to false)
# Set to true to allow automatic transfers
AUTO_EXECUTE_TRANSFERS=false
# Set to true to allow starting XI, bench, captain, and vice-captain updates
AUTO_SET_LINEUP=false
# Set to true to allow automatic chip plays
AUTO_PLAY_CHIPS=false
# Emergency stop defaults to true. Both this and the stop file must be clear in live mode.
EMERGENCY_STOP=true
# Maximum transfers per week
MAX_TRANSFERS_PER_WEEK=1
# Hits are disabled by default; values must be multiples of four.
MAX_TRANSFER_HIT_COST=0
# Minimum net xP gain required after taking a permitted hit
MIN_XP_GAIN_FOR_HIT=8
# Minimum aggregate model confidence for a transfer plan
MIN_TRANSFER_CONFIDENCE=0.80
# Ignore small or uncertain lineup/captain differences.
MIN_LINEUP_GAIN=0.5
MIN_LINEUP_CONFIDENCE=0.70
# Refuse mutations this many minutes before the deadline
DEADLINE_SAFETY_MINUTES=15
# Hours before deadline to switch to execute phase
PRE_DEADLINE_HOURS=2
# Polling interval in minutes
POLL_INTERVAL_MINUTES=30
# Exit after this many failed cycles so the process supervisor can restart the worker
MAX_CONSECUTIVE_CYCLE_FAILURES=3
# Poll trusted news and lineup leaks more frequently near the deadline
DEADLINE_NEWS_WINDOW_MINUTES=90
DEADLINE_NEWS_POLL_MINUTES=5
# Persist a full prediction snapshot at this interval (final window uses hourly snapshots)
FORECAST_SNAPSHOT_HOURS=6

# At least one remote alert channel is required for FPL_RUN_MODE=live.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Kapso WhatsApp is an informational channel only. Delivery never controls an
# FPL decision. Template mode is required for proactive messages outside the
# 24-hour customer-service window. Create an approved utility template with one
# named body parameter called `update`; never commit the real values below.
KAPSO_WHATSAPP_ENABLED=false
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WHATSAPP_TO=
KAPSO_WHATSAPP_MODE=template
KAPSO_WHATSAPP_TEMPLATE_NAME=fpl_agent_update
KAPSO_WHATSAPP_LANGUAGE=en_US
KAPSO_WHATSAPP_TEMPLATE_PARAMETER_NAME=update
KAPSO_WHATSAPP_TIMEOUT_SECONDS=8
KAPSO_WHATSAPP_MAX_ATTEMPTS=3

# Identity-independent ML is forecast-observation only and cannot execute team actions.
# Automatic mode generates, validates, caches, and refreshes the correct sidecar
# for each actionable gameweek. Static FPL_ML_FEATURE_SIDECAR is an alternative
# for offline/manual runs and cannot be combined with automatic mode.
FPL_ML_SHADOW_ENABLED=false
FPL_ML_MODEL_PATH=artifacts/ml/player-fixture-v1/model.json
FPL_ML_AUTO_FEATURES=false
FPL_ML_FEATURE_DIRECTORY=data/live/player-fixture-features-v1
FPL_ML_PYTHON_BIN=python3
FPL_ML_FEATURE_SCRIPT=scripts/ml/live_features.py
FPL_ML_FEATURE_TIMEOUT_SECONDS=600
FPL_ML_FEATURE_SIDECAR=

# Constrained LLM decision reviewer. It can approve or hold only a supplied
# deterministic legal option; it has no FPL tools or mutation authority.
FPL_LLM_ENABLED=false
FPL_LLM_REQUIRED_FOR_LIVE=true
FPL_LLM_MODEL=gpt-5.4-nano
FPL_LLM_CACHE_DIR=data/llm-cache
FPL_LLM_TIMEOUT_SECONDS=30
FPL_LLM_MIN_CONFIDENCE=0.75

# Twitter/X API (optional - for news monitoring)
# Get from https://developer.twitter.com/
TWITTER_BEARER_TOKEN=
# Must set to 'true' to enable Twitter (disabled by default to avoid rate limits/bans)
ENABLE_TWITTER=false
